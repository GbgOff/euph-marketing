# Copier ce fichier en « .env » et remplir. .env est ignoré par git.

# Clé personnelle Buffer : buffer.com -> Settings -> API -> API keys
BUFFER_TOKEN=

# Identifiant du canal TikTok. Le récupérer avec :  node publish.js channels
BUFFER_CHANNEL_ID=

# Racine publique GitHub Pages, SANS slash final.
# Format : https://<ton-pseudo-github>.github.io/<nom-du-depot>
PAGES_BASE_URL=
